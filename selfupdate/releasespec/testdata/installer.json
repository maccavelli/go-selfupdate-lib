{
  "schema": 1,
  "products": [
    {"name": "relay", "package": "./cmd/relay", "identity_args": ["version"]},
    {"name": "relayctl", "package": "./cmd/relayctl"}
  ],
  "platforms": [
    {"os": "linux", "arch": "amd64"},
    {"os": "darwin", "arch": "arm64"},
    {"os": "windows", "arch": "amd64"}
  ],
  "extras": [
    {"name": "relay-notes-{tag}.md", "path": "NOTES.md"}
  ],
  "prerelease_channels": ["rc"],
  "installer": {
    "name": "relay-suite",
    "env_prefix": "RELAY",
    "hooks": [
      {"when": "before_install", "product": "relayctl", "args": ["service", "stop", "--if-running"]},
      {"when": "after_install", "product": "relay", "args": ["configure"]}
    ]
  }
}
