{
  "schema": 1,
  "products": [
    {"name": "relay", "package": "./cmd/relay", "identity_args": ["version"]}
  ],
  "platforms": [
    {"os": "linux", "arch": "amd64"},
    {"os": "linux", "arch": "arm64"},
    {"os": "darwin", "arch": "arm64"},
    {"os": "windows", "arch": "amd64"},
    {"os": "windows", "arch": "arm64"}
  ],
  "packaging": "binary",
  "extras": [
    {"name": "relay-notes-{tag}.txt", "path": "internal/cmd/selfupdate-release/testdata/fixture/notes.txt"}
  ],
  "installer": {
    "hooks": [
      {"when": "after_install", "product": "relay", "args": ["mark-installed"]}
    ]
  }
}
